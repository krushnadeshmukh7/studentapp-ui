pipeline {
    agent {
        label 'worker'
    }

    environment {
        MY_AWS_CRED = credentials('aws-cred')
    }

    tools {
        terraform 'terraform'
    }

    stages {

        stage('Checkout') {
            steps {
                git 'https://github.com/krushnadeshmukh7/studentapp-ui.git'
                echo 'Cloning is successful'
            }
        }

        stage('Terraform Init') {
            steps {
                sh 'terraform init'
            }
        }

        stage('Terraform Validate') {
            steps {
                sh 'terraform validate'
            }
        }

        stage('Terraform Apply') {
            steps {
                sh 'terraform apply -auto-approve'
            }
        }
    }

    post {
        success {
            echo 'Infrastructure deployment successful!'
            echo 'Starting student-ui job...'

            build job: 'student-ui', wait: true
        }

        failure {
            echo 'Infrastructure deployment failed.'
            echo 'student-ui job will not start.'
        }
    }
}