pipeline {
    agent {
        label "worker"
    }

    tools {
        maven 'maven'
    }

    stages {
        stage ("checkout") {
            steps {
                git 'https://github.com/krushnadeshmukh7/studentapp-ui.git'
                echo "clonning is successful"
            }
        }

        stage ("build") {
            steps {
                sh 'mvn clean package'
            }
            post {
                always {
                    archiveArtifacts artifacts: '**/target/*.war', fingerprint: true
                }
            }
        }
    }
}