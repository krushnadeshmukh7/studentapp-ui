pipeline {
    agent {
        label 'worker'
    }

    tools {
        maven 'maven'
    }

    environment {
        MY_AWS_CRED = credentials('aws-cred')
    }

    stages {

        stage('Checkout') {
            steps {
                git 'https://github.com/krushnadeshmukh7/studentapp-ui.git'
                echo 'Cloning is successful'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package'
            }

            post {
                success {
                    archiveArtifacts artifacts: '**/target/*.war', fingerprint: true
                }
            }
        }

        stage('Artifacts to S3') {
            steps {
                sh '''
                    aws s3 cp target/*.war s3://krushna.online123123/Artifacts/student.war
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar') {
                    sh 'mvn sonar:sonar'
                }
            }
        }

        stage('Quality Gates') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
        stage('Docker Build') {
            steps {
                sh '''
                    docker build -t student .
                    docker images
                    '''

            }
        }
        stage('Push image to ECR') {
            steps {
                sh '''
                    aws ecr get-login-password --region us-west-2 | docker login --username AWS --password-stdin 823787500858.dkr.ecr.us-west-2.amazonaws.com
                    docker tag student:latest 823787500858.dkr.ecr.us-west-2.amazonaws.com/student:latest
                    docker push 823787500858.dkr.ecr.us-west-2.amazonaws.com/student:latest
                    '''
            }
        }
    }
}