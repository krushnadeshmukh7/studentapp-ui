pipeline {
    agent {
        lable "worker"
    }
    tools {
        maven 'maven'
    }
    stages {
        stage ("checkout") {
            steps{
                git 'https://github.com/krushnadeshmukh7/studentapp-ui.git'
                echo "clonning is sucessful"
            }
        }
        stage("Build") {
            steps{
                sh 'mvn clean package'
            }
            post{
                success{
                    archiArtifacts artifacts: '**/target/*.war',fingerprint: true
                }
            }
        }
    }

}