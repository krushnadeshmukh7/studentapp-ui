pipeline {
    agent {
        label 'worker'
    }

    tools {
        maven 'maven'
    }

    stages {

        stage('Checkout') {
            steps {
                git 'https://github.com/krushnadeshmukh7/studentapp-ui.git'
                echo 'Cloning is successful'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package'
            }

            post {
                success {
                    archiveArtifacts artifacts: '**/target/*.war', fingerprint: true
                }
            }
        }
        stage('Artifacts to s3') {
            steps{
                ssh '''
                  aws s3 cp target/*.war s3://krushna.online123123/Artifacts/stuent.war
                  '''
            }
        }
    }
}