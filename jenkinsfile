pipeline {
    agent {
        label "worker"
    }

    tools {
        maven 'maven'
    }
    
    environment {
        my_aws_cred = credentials('aws-cred')
    }


    stages {

        stage("Checkout") {
            steps {
                git 'https://github.com/krushnadeshmukh7/studentapp-ui.git'
                echo "Cloning is successful"
            }
        }

        stage("Build") {
            steps {
                sh 'mvn clean package'
            }

            post {
                always {
                    archiveArtifacts artifacts: '**/target/*.war', fingerprint: true
                }
            }
        }

        stage("Artifacts to S3") {
            steps {
                sh '''
                    aws s3 cp target/*.war s3://krushna.online.123123/Artifacts/student.war
                '''
            }
        }
    }
}